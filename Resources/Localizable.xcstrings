    },
    "镜像只在设置虚拟 Mac 时使用一次，删除后可以随时重新下载。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The image is only used once, when setting up the Virtual Mac. You can download it again at any time."
          }
        }
      }
    },
    "阻止写入系统目录、注册开机自启动和后台服务、发送通知、遥控其他 App" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocks writing to system folders, registering login items and background services, sending notifications and controlling other apps"
