        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer scripts skipped"
          }
        }
      }
    },
    "安装镜像缓存已不再需要，可以在下方「占用空间」里删除。" : {
      "localizations" : {
