      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run"
          }
        }
      }
    },
    "唤醒" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wake"
          }
        }
      }
    },
    "在 %@ 端口等待别的设备连进来" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for other devices to connect on port %@"
          }
        }
      }
    },
    "在 ~/Applications/MacBox 放一个启动器，像普通 App 一样打开" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put a launcher in ~/Applications/MacBox so you can open it like any other app"
          }
        }
      }
    },
    "在「全部应用」里双击一个应用即可打开。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-click an app in “All Apps” to open it."
          }
        }
      }
    },
    "在一台独立的虚拟 Mac 里运行，与本机完全隔开。兼容性最好，但占用约 30 GB、启动较慢。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs in a separate virtual Mac, fully walled off from this Mac. Best compatibility, but takes about 30 GB and starts more slowly."
          }
        }
      }
    },
    "在本机隔离中打开一次应用，退出后这里就有一份报告。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the app once in Native Isolation, and a report appears here after it quits."
          }
        }
      }
    },
    "在沙盒外启动程序" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launch a program outside the sandbox"
          }
        }
      }
